# 명세 11.4절 — 이 파일을 backend/.env 로 복사한 뒤 값을 채운다.
# .env 는 절대 커밋하지 않는다 (.gitignore 참고).

# --- DB ---
# 로컬(호스트에서 직접 실행): localhost
# Docker Compose 내부에서 실행: 호스트를 db 로 바꿀 것
# AWS 전환 후(Phase 7b): RDS 엔드포인트로 값만 교체 — 코드 변경 불필요 (8.1절)
DATABASE_URL=postgresql://user:pass@localhost:5432/subagent_viz

# agent_logs 보관 기간(일)과 정리 작업 주기(시간).
# 로그는 append-only라 방치하면 무한정 쌓인다 — 20개 에이전트 x 2초면
# 하루 약 86만 행이다. 기본은 30일 보관 + 6시간마다 자동 삭제.
LOG_RETENTION_DAYS=30
LOG_PURGE_INTERVAL_HOURS=6

# --- 인증 ---
# REST API 인증용 X-API-Key 헤더 값 (9.3절)
API_KEY=change-me-local-dev-key

# CORS 및 WebSocket Origin 허용 대상
# AWS 전환 후: https://<vercel-도메인> (8.1절)
WS_ALLOWED_ORIGIN=http://localhost:3000

# WebSocket 인증 토큰 — Phase 7b부터 필수, 그전까지는 비워 둔다 (8.1절)
# 단, Phase 7a(Tunnel로 임시 공개) 시점에는 앞당겨 적용할 것
#   → 근거: docs/SPEC-NOTES.md "열려 있는 항목" 참고
AUTH_TOKEN=

# --- 저장소 ---
# glTF 모델 저장 경로 (9.2 / 10.6절)
# Docker Compose 실행 시에는 compose 파일이 /app/uploads 로 덮어쓴다.
UPLOAD_DIR=uploads

# --- 목업 (Phase 0~5) ---
# 목업 에이전트 수. 명세 10.1절은 Phase 3(리깅 캐릭터) 진입 전에 큐브 스텁으로
# 20개 동시 렌더링 성능을 먼저 재보라고 권고한다 — 그때 이 값을 20으로 올린다.
MOCK_AGENT_COUNT=3

# --- 재시도 정책 (11.2절) ---
MAX_RETRY_COUNT=3
RETRY_INITIAL_INTERVAL=1.0
RETRY_BACKOFF_FACTOR=2.0

# --- LLM (Phase 6) ---
# fake | anthropic | openai
# fake 는 실제 호출 없이 응답을 흉내 낸다 — 비용 0, API 키 불필요.
# 파이프라인 구조를 먼저 완성하고 나중에 어댑터만 갈아끼우기 위한 것이다.
LLM_PROVIDER=fake
LLM_MODEL=

# 가짜 LLM 의 지연(초)과 실패율(0~1).
# 실패를 섞어야 retrying/error 연출을 검증할 수 있다.
FAKE_LLM_FAILURE_RATE=0.25
FAKE_LLM_MIN_DELAY=0.8
FAKE_LLM_MAX_DELAY=3.0

# 질문 하나당 조사 담당 수. 검증·정리 담당 2명이 더해진다.
RESEARCH_AGENT_COUNT=3
# 작업을 마친 에이전트가 씬에 머무는 시간(초). 지나면 화면에서만 사라지고
# DB 기록과 이력은 남는다.
RUN_AGENT_LINGER_SECONDS=8.0

# 1단계는 .env, 2단계(멀티테넌트)는 DB 암호화 저장으로 이전 (11.4절)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
