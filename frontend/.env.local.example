# 명세 11.4 / 8.3절 — 이 파일을 frontend/.env.local 로 복사한다.
#
# 로컬 개발:      ws://localhost:8000/ws
# AWS 전환 후:    wss://<EC2 또는 ALB 도메인>/ws
#
# 전환 당일에는 Vercel 프로젝트 설정에서 이 값만 바꾸고 재배포하면 된다.
# 프론트엔드 코드는 수정할 필요가 없다.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# REST API 오리진. glTF 모델 정적 서빙 경로(/models/...)를 절대 URL로
# 조립하는 데에도 쓰인다 — docs/SPEC-NOTES.md 5번 항목 참고.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
