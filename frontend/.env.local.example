# 명세 11.4 / 8.3절 — 이 파일을 frontend/.env.local 로 복사한다.

# --- 브라우저로 나가는 값 (NEXT_PUBLIC_ 접두사) ---
#
# 로컬 개발:   ws://localhost:8000/ws
# AWS 전환 후: wss://<EC2 또는 ALB 도메인>/ws
#
# 전환 당일에는 Vercel 프로젝트 설정에서 이 값만 바꾸고 재배포하면 된다.
# 프론트엔드 코드는 수정할 필요가 없다.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# glTF 모델 정적 서빙 경로(/models/...)를 절대 URL로 조립하는 데 쓴다.
# docs/SPEC-NOTES.md 5번 항목 참고.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- 서버에서만 쓰는 값 (절대 NEXT_PUBLIC_ 을 붙이지 말 것) ---
#
# REST 호출은 브라우저가 백엔드를 직접 부르지 않고 Next 라우트
# (/api/backend/...)를 거친다. API Key가 번들에 실려 브라우저로 새는 것을
# 막기 위해서다 — app/api/backend/[...path]/route.ts 참고.
#
# ⚠️ 여기에 NEXT_PUBLIC_ 을 붙이면 키가 그대로 공개된다. 붙이지 말 것.
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=change-me-local-dev-key
